@model List<PostaKutusuServisi.Models.AdminUserListItemViewModel>
@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var search = ViewBag.Search as string;
}

<div class="mx-auto w-full max-w-5xl">

    <div class="mb-stack-lg flex flex-col gap-stack-sm sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-headline-md text-on-surface">Kullanıcılar</h1>
            <p class="mt-1 text-body-sm text-on-surface-variant">@Model.Count kullanıcı listeleniyor</p>
        </div>

        <a asp-controller="Admin" asp-action="Index"
           class="rounded-lg border border-outline-variant px-4 py-2 text-center text-label-md text-on-surface-variant transition-colors hover:bg-surface-container-high hover:text-on-surface">
            Panele dön
        </a>
    </div>

    @if (TempData["AdminSuccess"] is not null)
    {
        <div class="mb-stack-md flex items-center gap-2 rounded-lg border border-primary/40 bg-primary/10 p-stack-md text-body-sm text-primary">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            @TempData["AdminSuccess"]
        </div>
    }

    @if (TempData["AdminError"] is not null)
    {
        <div class="mb-stack-md flex items-center gap-2 rounded-lg border border-error bg-error-container p-stack-md text-body-sm text-on-error-container">
            <svg class="h-5 w-5 shrink-0 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            @TempData["AdminError"]
        </div>
    }

    <!-- arama -->
    <form asp-controller="Admin" asp-action="Users" method="get"
          class="mb-stack-md flex flex-col gap-stack-sm sm:flex-row">

        <div class="relative min-w-0 flex-1">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                <svg class="h-4 w-4 text-outline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            <input name="search" type="text" value="@search" placeholder="Ad, e-posta veya kullanıcı adı ara..."
                   class="w-full rounded-lg border border-outline-variant bg-surface-container-lowest py-2 pl-9 pr-3 text-body-sm text-on-surface placeholder:text-outline focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>

        <button type="submit"
                class="shrink-0 rounded-lg bg-primary-container px-5 py-2 text-label-md text-white transition-all hover:opacity-90">
            Ara
        </button>

        @if (!string.IsNullOrWhiteSpace(search))
        {
            <a asp-controller="Admin" asp-action="Users"
               class="shrink-0 rounded-lg border border-outline-variant px-5 py-2 text-center text-label-md text-on-surface-variant transition-colors hover:bg-surface-container-high">
                Temizle
            </a>
        }
    </form>

    <!-- liste -->
    @if (!Model.Any())
    {
        <div class="rounded-xl border border-dashed border-outline-variant bg-surface-container-lowest px-6 py-12 text-center">
            <h2 class="text-headline-sm text-on-surface">Kullanıcı bulunamadı</h2>
            <p class="mt-2 text-body-sm text-on-surface-variant">Arama koşullarınıza uyan kullanıcı yok.</p>
        </div>
    }
    else
    {
        <div class="overflow-hidden rounded-xl border border-outline-variant">

            @foreach (var user in Model)
            {
                <div class="flex flex-col gap-stack-sm border-b border-outline-variant bg-surface-container-lowest p-stack-md last:border-b-0 sm:flex-row sm:items-center">

                    <!-- bilgi -->
                    <div class="flex min-w-0 flex-1 flex-col">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="truncate text-label-md text-on-surface">@user.FullName</span>

                            @if (user.IsAdmin)
                            {
                                <span class="shrink-0 rounded-full bg-primary-container px-2 py-0.5 text-label-sm text-white">Yönetici</span>
                            }

                            @if (!user.IsActive)
                            {
                                <span class="shrink-0 rounded-full border border-error px-2 py-0.5 text-label-sm text-error">Pasif</span>
                            }
                        </div>

                        <span class="truncate text-body-sm text-on-surface-variant">@user.Email</span>
                        <span class="truncate text-label-sm text-outline">@user.UserName &middot; @user.SentCount mesaj</span>
                    </div>

                    <!-- işlemler -->
                    <div class="flex shrink-0 gap-2">

                        <form asp-controller="Admin" asp-action="ToggleActive" method="post">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit"
                                    class="rounded-lg border px-4 py-2 text-label-md transition-colors @(user.IsActive ? "border-outline-variant text-on-surface-variant hover:border-error hover:text-error" : "border-primary/40 text-primary hover:bg-primary/10")">
                                @(user.IsActive ? "Pasif yap" : "Aktifleştir")
                            </button>
                        </form>

                        <form asp-controller="Admin" asp-action="ToggleAdmin" method="post">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit"
                                    class="rounded-lg border border-outline-variant px-4 py-2 text-label-md text-on-surface-variant transition-colors hover:bg-surface-container-high hover:text-on-surface">
                                @(user.IsAdmin ? "Yöneticiliği al" : "Yönetici yap")
                            </button>
                        </form>

                    </div>

                </div>
            }

        </div>
    }

</div>

