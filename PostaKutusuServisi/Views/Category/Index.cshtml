@model List<PostaKutusuServisi.Models.CategoryListItemViewModel>
@{
    ViewData["Title"] = "Kategoriler";

    var inputClass = "w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface transition-shadow placeholder:text-outline focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary";
}

<div class="mx-auto w-full max-w-3xl">

    <div class="mb-stack-lg">
        <h1 class="text-headline-md text-on-surface">Kategoriler</h1>
        <p class="mt-1 text-body-sm text-on-surface-variant">
            Mesajlarınızı düzenlemek için kendi kategorilerinizi oluşturun.
        </p>
    </div>

    @if (TempData["CategorySuccess"] is not null)
    {
        <div class="mb-stack-md flex items-center gap-2 rounded-lg border border-primary/40 bg-primary/10 p-stack-md text-body-sm text-primary">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            @TempData["CategorySuccess"]
        </div>
    }

    @if (TempData["CategoryError"] is not null)
    {
        <div class="mb-stack-md flex items-center gap-2 rounded-lg border border-error bg-error-container p-stack-md text-body-sm text-on-error-container">
            <svg class="h-5 w-5 shrink-0 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            @TempData["CategoryError"]
        </div>
    }

    <!-- ============ YENİ KATEGORİ ============ -->
    <div class="mb-stack-lg rounded-xl border border-outline-variant bg-surface-container-lowest p-stack-md">

        <h2 class="mb-stack-sm text-label-md text-on-surface">Yeni Kategori</h2>

        <form asp-controller="Category" asp-action="Create" method="post"
              class="flex flex-col gap-stack-sm sm:flex-row sm:items-end">

            <div class="flex min-w-0 flex-1 flex-col gap-1">
                <label for="newName" class="text-label-sm text-on-surface-variant">Ad</label>
                <input id="newName" name="Name" type="text" required maxlength="40"
                       placeholder="Örn. İş, Özel, Faturalar" class="@inputClass" />
            </div>

            <div class="flex shrink-0 flex-col gap-1">
                <label for="newColor" class="text-label-sm text-on-surface-variant">Renk</label>
                <input id="newColor" name="Color" type="color" value="#3b72e0"
                       class="h-[42px] w-16 cursor-pointer rounded-lg border border-outline-variant bg-surface-container-lowest p-1" />
            </div>

            <button type="submit"
                    class="shrink-0 rounded-lg bg-primary-container px-5 py-2.5 text-label-md text-white transition-all hover:opacity-90 active:scale-[0.98]">
                Ekle
            </button>

        </form>
    </div>

    <!-- ============ LİSTE ============ -->
    @if (!Model.Any())
    {
        <div class="rounded-xl border border-dashed border-outline-variant bg-surface-container-lowest px-6 py-12 text-center">
            <h2 class="text-headline-sm text-on-surface">Henüz kategoriniz yok</h2>
            <p class="mt-2 text-body-sm text-on-surface-variant">
                Yukarıdaki formdan ilk kategorinizi oluşturabilirsiniz.
            </p>
        </div>
    }
    else
    {
        <div class="overflow-hidden rounded-xl border border-outline-variant">

            @foreach (var item in Model)
            {
                <div class="flex flex-col gap-stack-sm border-b border-outline-variant bg-surface-container-lowest p-stack-md last:border-b-0 sm:flex-row sm:items-center">

                    <form asp-controller="Category" asp-action="Update" method="post"
                          class="flex min-w-0 flex-1 flex-col gap-stack-sm sm:flex-row sm:items-center">

                        <input type="hidden" name="Id" value="@item.Id" />

                        <input name="Color" type="color" value="@(item.Color ?? "#3b72e0")"
                               class="h-9 w-12 shrink-0 cursor-pointer rounded-lg border border-outline-variant bg-surface-container-lowest p-1" />

                        <input name="Name" type="text" value="@item.Name" required maxlength="40"
                               class="@inputClass min-w-0 flex-1" />

                        <span class="shrink-0 text-label-sm text-outline">
                            @item.MessageCount mesaj
                        </span>

                        <button type="submit"
                                class="shrink-0 rounded-lg border border-outline-variant px-4 py-2 text-label-md text-on-surface transition-colors hover:bg-surface-container-high">
                            Kaydet
                        </button>

                    </form>

                    <form asp-controller="Category" asp-action="Delete" method="post" class="shrink-0"
                          onsubmit="return confirm('@item.Name kategorisi silinecek. Mesajlar silinmez, kategorisiz kalır. Onaylıyor musunuz?');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" aria-label="Kategoriyi sil"
                                class="rounded-lg border border-outline-variant p-2 text-outline transition-colors hover:border-error hover:text-error">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                        </button>
                    </form>

                </div>
            }

        </div>
    }

</div>
