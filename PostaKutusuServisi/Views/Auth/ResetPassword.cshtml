@using PostaKutusuServisi.DTOs.UserDtos
@model ResetPasswordDto

@{
    ViewData["Title"] = "ResetPassword";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var inputClass = "w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface transition-shadow placeholder:text-on-surface-variant focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary";
}

<div class="flex justify-center py-4">

    <div class="w-full max-w-md rounded-xl border border-outline-variant bg-surface-container-lowest p-stack-lg">

        <div class="mb-stack-lg text-center">
            <h1 class="text-headline-sm text-on-surface">Yeni Şifre Belirle</h1>
            <p class="mt-2 text-body-sm text-on-surface-variant">
                @Model.Email adresi için yeni bir şifre oluşturun.
            </p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div role="alert" class="mb-stack-md flex items-start gap-2 rounded-lg border border-error bg-error-container p-stack-md text-body-sm text-on-error-container">
                <svg class="h-5 w-5 shrink-0 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="flex flex-col gap-1">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <span>@error.ErrorMessage</span>
                    }
                </div>
            </div>
        }

        <form asp-controller="Auth" asp-action="ResetPassword" method="post" class="flex flex-col gap-stack-md">

            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="flex flex-col gap-stack-sm">
                <label asp-for="NewPassword" class="text-label-md text-on-surface">Yeni Şifre</label>
                <input asp-for="NewPassword" type="password" required autocomplete="new-password"
                       placeholder="En az 6 karakter" class="@inputClass" />
            </div>

            <div class="flex flex-col gap-stack-sm">
                <label asp-for="ConfirmPassword" class="text-label-md text-on-surface">Yeni Şifre (Tekrar)</label>
                <input asp-for="ConfirmPassword" type="password" required autocomplete="new-password"
                       placeholder="Şifrenizi tekrar girin" class="@inputClass" />
            </div>

            <button type="submit"
                    class="w-full rounded-lg bg-primary-container py-3 text-label-md text-white transition-all hover:opacity-90 active:scale-[0.98]">
                Şifreyi Güncelle
            </button>

            <div class="text-center">
                <a asp-controller="Auth" asp-action="Login"
                   class="text-label-md text-secondary transition-colors hover:text-primary">
                    Giriş ekranına dön
                </a>
            </div>

        </form>
    </div>
</div>
