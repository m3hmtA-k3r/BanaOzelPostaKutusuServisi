@using PostaKutusuServisi.Entities
@model List<UserMessage>
@{
    ViewData["Title"] = "Yıldızlı";
}

<div class="mx-auto w-full max-w-5xl">

    <!-- başlık -->
    <div class="mb-stack-lg flex items-center gap-3">
        <svg class="h-6 w-6 shrink-0 text-tertiary" fill="currentColor" viewBox="0 0 24 24">
            <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
        </svg>
        <div>
            <h1 class="text-headline-md text-on-surface">Yıldızlı</h1>
            <p class="mt-1 text-body-sm text-on-surface-variant">
                @Model.Count mesaj işaretlenmiş
            </p>
        </div>
    </div>

    @await Component.InvokeAsync("_MessageFilterBar", new
    {
        filter = (PostaKutusuServisi.DTOs.UserMessageDto.MessageFilterDto)ViewBag.Filter,
        action = "Important"
    })



    @if (!Model.Any())
    {
        <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-outline-variant bg-surface-container-lowest px-6 py-16 text-center">
            <svg class="mb-4 h-12 w-12 text-outline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
            <h2 class="text-headline-sm text-on-surface">Yıldızlı mesajınız yok</h2>
            <p class="mt-2 max-w-sm text-body-sm text-on-surface-variant">
                Gelen kutunuzda bir mesajın yanındaki yıldıza dokunarak onu buraya ekleyebilirsiniz.
            </p>
            <a asp-controller="Message" asp-action="Index"
               class="mt-6 rounded-lg border border-outline-variant px-5 py-2.5 text-label-md text-primary transition-colors hover:bg-primary/10">
                Gelen kutusuna dön
            </a>
        </div>
    }
    else
    {
        @await Component.InvokeAsync("_UserMessageList", new { messages = Model })

        @await Component.InvokeAsync("_Pagination", new
        {
            filter = (PostaKutusuServisi.DTOs.UserMessageDto.MessageFilterDto)ViewBag.Filter,
        totalPages = (int)ViewBag.TotalPages,
        totalCount = (int)ViewBag.TotalCount,
        action = "Important"
        })
    }


</div>
