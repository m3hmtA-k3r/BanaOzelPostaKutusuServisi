@using PostaKutusuServisi.Entities
@model List<UserMessage>
@{
    ViewData["Title"] = "Taslaklar";
}

<div class="mx-auto w-full max-w-5xl">

    <div class="mb-stack-lg flex items-center gap-3">
        <svg class="h-6 w-6 shrink-0 text-on-surface-variant" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        <div>
            <h1 class="text-headline-md text-on-surface">Taslaklar</h1>
            <p class="mt-1 text-body-sm text-on-surface-variant">@Model.Count kaydedilmiş taslak</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-outline-variant bg-surface-container-lowest px-6 py-16 text-center">
            <h2 class="text-headline-sm text-on-surface">Taslağınız yok</h2>
            <p class="mt-2 max-w-sm text-body-sm text-on-surface-variant">
                Yazmaya başlayıp "Taslak olarak kaydet" derseniz mesajınız burada bekler.
            </p>
            <a asp-controller="Message" asp-action="SendMail"
               class="mt-6 rounded-lg border border-outline-variant px-5 py-2.5 text-label-md text-primary transition-colors hover:bg-primary/10">
                Yeni mesaj yaz
            </a>
        </div>
    }
    else
    {
        <div class="overflow-hidden rounded-lg border border-outline-variant">
            @foreach (var item in Model)
            {
                <div class="group flex items-center gap-3 border-b border-outline-variant bg-surface-container-lowest px-4 py-2.5 transition-colors last:border-b-0 hover:bg-surface-container-high">

                    <a asp-controller="Message" asp-action="EditDraft" asp-route-id="@item.Id"
                       class="flex min-w-0 flex-1 items-center gap-3">

                        <span class="w-32 shrink-0 truncate text-body-sm text-on-surface-variant sm:w-44">
                            @if (item.Receiver is not null)
                            {
                                <span class="text-outline">Kime: </span>
                                @item.Receiver.FirstName @item.Receiver.LastName
                            }
                            else
                            {
                                <span class="text-error">Alıcı yok</span>
                            }
                        </span>

                        <span class="min-w-0 flex-1 truncate">
                            <span class="text-body-sm text-on-surface">
                                @(string.IsNullOrWhiteSpace(item.Subject) ? "(Konu yok)" : item.Subject)
                            </span>
                            <span class="text-body-sm text-outline">
                                &ndash; @item.Body
                            </span>
                        </span>

                        <span class="w-16 shrink-0 text-right text-label-sm text-outline">
                            @item.SendDate.ToString("d MMM")
                        </span>

                    </a>

                    <form asp-controller="Message" asp-action="DeleteDraft" method="post" class="shrink-0">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" aria-label="Taslağı sil"
                                class="rounded p-1 text-outline transition-colors hover:text-error">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                        </button>
                    </form>

                </div>

            }
        </div>
    }

</div>
