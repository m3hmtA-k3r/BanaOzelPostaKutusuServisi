@model UserMessage
@{
    ViewData["Title"] = Model.Subject;

    var currentUserId = (int)ViewBag.CurrentUserId;
    var isSender = Model.SenderId == currentUserId;
    var person = isSender ? Model.Receiver : Model.Sender;
}


<div class="mx-auto w-full max-w-3xl">

    <!-- geri -->
    <a asp-controller="Message" asp-action="Index"
       class="mb-stack-lg inline-flex items-center gap-2 text-label-md text-primary transition-colors hover:text-secondary">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Gelen Kutusuna Dön
    </a>

    @if (TempData["ReportSuccess"] is not null)
    {
        <div class="mb-stack-md flex items-center gap-2 rounded-lg border border-primary/40 bg-primary/10 p-stack-md text-body-sm text-primary">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            @TempData["ReportSuccess"]
        </div>
    }

    @if (TempData["ReportInfo"] is not null)
    {
        <div class="mb-stack-md flex items-center gap-2 rounded-lg border border-outline-variant bg-surface-container p-stack-md text-body-sm text-on-surface-variant">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            @TempData["ReportInfo"]
        </div>
    }


    <div class="rounded-xl border border-outline-variant bg-surface-container-lowest p-stack-lg">

        <!-- konu -->
        <h1 class="text-headline-md text-on-surface">@Model.Subject</h1>

        @if (Model.Category is not null)
        {
            <span class="mt-2 inline-flex items-center gap-1.5 rounded-full border border-outline-variant px-3 py-1 text-label-sm text-on-surface-variant">
                <span class="h-2 w-2 rounded-full" style="background-color: @(Model.Category.Color ?? "#3b72e0")"></span>
                @Model.Category.Name
            </span>
        }


        <!-- kişi + tarih -->
        <div class="mt-stack-md flex items-center gap-3 border-b border-outline-variant pb-stack-md">

            @await Component.InvokeAsync("_Avatar", new { user = person, size = "md" })

            <div class="flex min-w-0 flex-1 flex-col">
                <span class="truncate text-label-md text-on-surface">
                    @if (isSender)
                    {
                        <span class="text-outline">Kime:</span>
                    }
                    @person.FirstName @person.LastName
                </span>
                <span class="truncate text-label-sm text-on-surface-variant">
                    @person.Email
                </span>
            </div>

            <span class="shrink-0 text-label-sm text-primary">
                @Model.SendDate.ToString("dd.MM.yyyy, HH:mm")
            </span>

        </div>


        <!-- gövde -->
        <div class="py-stack-lg">
            <p class="whitespace-pre-wrap break-words text-body-md leading-relaxed text-on-surface">@Model.Body</p>
        </div>

        <!-- eylemler -->
        <div class="flex flex-wrap gap-3 border-t border-outline-variant pt-stack-md">

            <a asp-controller="Message" asp-action="SendMail" ...>Cevapla</a>

            <a asp-controller="Message" asp-action="Forward" ...>İlet</a>

            <form asp-controller="Message" asp-action="Delete" method="post" class="ml-auto">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" ...>Sil</button>
            </form>

        </div>

        @if (!isSender)
        {
            <details class="mt-stack-md border-t border-outline-variant pt-stack-md">

                <summary class="cursor-pointer text-label-sm text-outline transition-colors hover:text-error">
                    Bu mesajı şikayet et
                </summary>

                <form asp-controller="Message" asp-action="Report" method="post"
                      class="mt-stack-md flex flex-col gap-stack-sm rounded-lg border border-outline-variant bg-surface-container-low p-stack-md">

                    <input type="hidden" name="messageId" value="@Model.Id" />

                    <div class="flex flex-col gap-1">
                        <label for="reason" class="text-label-sm text-on-surface-variant">Şikayet sebebi</label>
                        <select id="reason" name="reason" required
                                class="w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-sm text-on-surface focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary">
                            <option value="Spam">İstenmeyen içerik (spam)</option>
                            <option value="Harassment">Taciz veya hakaret</option>
                            <option value="Inappropriate">Uygunsuz içerik</option>
                            <option value="Other">Diğer</option>
                        </select>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label for="description" class="text-label-sm text-on-surface-variant">Açıklama (isteğe bağlı)</label>
                        <textarea id="description" name="description" rows="3" maxlength="500"
                              placeholder="Durumu kısaca açıklayabilirsiniz..."
                              class="w-full resize-y rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-sm text-on-surface placeholder:text-outline focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
                    </div>

                    <div class="flex justify-end">
                        <button type="submit"
                                class="rounded-lg border border-error px-5 py-2 text-label-md text-error transition-colors hover:bg-error/10">
                            Şikayeti Gönder
                        </button>
                    </div>

                </form>
            </details>
        }

    </div>
</div>
