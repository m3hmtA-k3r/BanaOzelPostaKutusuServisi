@using PostaKutusuServisi.DTOs.UserMessageDto
@model SendMailDto
@{
    ViewData["Title"] = "Yeni Mesaj";
}

<div class="mx-auto w-full max-w-2xl">

    <!-- başlık -->
    <div class="mb-stack-lg flex items-center gap-3">
        <a asp-controller="Message" asp-action="Index"
           class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant transition-colors hover:bg-surface-container hover:text-on-surface">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
        </a>
        <div>
            <h1 class="text-headline-md text-on-surface">Yeni Mesaj</h1>
            <p class="mt-1 text-body-sm text-on-surface-variant">
                Mesajınız yalnızca sisteme kayıtlı kullanıcılara gönderilebilir.
            </p>
        </div>
    </div>

    <div class="rounded-xl border border-outline-variant bg-surface-container-lowest p-stack-lg">

        <!-- hata alanı -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div role="alert" class="mb-stack-lg flex items-start gap-stack-sm rounded-lg border border-error bg-error-container p-stack-md text-on-error-container">
                <svg class="h-5 w-5 shrink-0 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M12 9v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="flex flex-col">
                    <span class="text-label-md">Mesaj gönderilemedi</span>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <span class="text-body-sm">@error.ErrorMessage</span>
                    }
                </div>
            </div>
        }

        <form asp-controller="Message" asp-action="SendMail" method="post" class="flex flex-col gap-stack-md">

            <input type="hidden" asp-for="DraftId" />

            <!-- alıcı -->
            <div class="flex flex-col gap-stack-sm">
                <label asp-for="ReceiverMail" class="text-label-md text-on-surface">Alıcı</label>
                <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                        <svg class="h-5 w-5 text-outline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                    </div>
                    <input asp-for="ReceiverMail" type="text" placeholder="ornek@sirket.com" required autocomplete="off"
                           class="w-full rounded-lg border border-outline-variant bg-surface-container-lowest py-2 pl-10 pr-3 text-body-md text-on-surface transition-shadow placeholder:text-on-surface-variant focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
            </div>

            <!-- konu -->
            <div class="flex flex-col gap-stack-sm">
                <label asp-for="Subject" class="text-label-md text-on-surface">Konu</label>
                <input asp-for="Subject" type="text" placeholder="Mesajınızın konusu" required autocomplete="off"
                       class="w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface transition-shadow placeholder:text-on-surface-variant focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary" />
            </div>

            <!-- kategori -->
            <div class="flex flex-col gap-stack-sm">
                <label asp-for="CategoryId" class="text-label-md text-on-surface">Kategori</label>
                <select asp-for="CategoryId"
                        class="w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface transition-shadow focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary">
                    <option value="">Kategorisiz</option>
                    @foreach (var category in (List<PostaKutusuServisi.Entities.Category>)ViewBag.Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>



            <!-- mesaj -->
            <div class="flex flex-col gap-stack-sm">
                <label asp-for="Body" class="text-label-md text-on-surface">Mesaj</label>
                <textarea asp-for="Body" rows="8" placeholder="Mesajınızı buraya yazın..." required
                          class="w-full resize-y rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface transition-shadow placeholder:text-on-surface-variant focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
            </div>

            <!-- butonlar -->
            <div class="mt-stack-sm flex flex-col-reverse gap-stack-sm sm:flex-row sm:justify-end">

                <a asp-controller="Message" asp-action="Index"
                   class="rounded-lg border border-outline-variant px-5 py-2.5 text-center text-label-md text-on-surface-variant transition-colors hover:bg-surface-container hover:text-on-surface">
                    Vazgeç
                </a>

                <button type="submit" name="operation" value="draft" formnovalidate
                        class="rounded-lg border border-outline-variant px-5 py-2.5 text-label-md text-on-surface transition-colors hover:bg-surface-container-high">
                    Taslak olarak kaydet
                </button>

                <button type="submit" name="operation" value="send"
                        class="flex items-center justify-center gap-2 rounded-lg bg-primary-container px-5 py-2.5 text-label-md text-white transition-all hover:opacity-90 active:scale-[0.98]">
                    Gönder
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                    </svg>
                </button>


            </div>


        </form>
    </div>
</div>
