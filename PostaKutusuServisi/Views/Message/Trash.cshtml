@using PostaKutusuServisi.Entities
@model List<UserMessage>
@{
    ViewData["Title"] = "Çöp Kutusu";
}

<div class="mx-auto w-full max-w-5xl">

    <div class="mb-stack-lg flex items-center gap-3">
        <svg class="h-6 w-6 shrink-0 text-on-surface-variant" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        <div>
            <h1 class="text-headline-md text-on-surface">Çöp Kutusu</h1>
            <p class="mt-1 text-body-sm text-on-surface-variant">@Model.Count mesaj</p>
        </div>
    </div>
    @await Component.InvokeAsync("_MessageFilterBar", new
    {
        filter = (PostaKutusuServisi.DTOs.UserMessageDto.MessageFilterDto)ViewBag.Filter,
        action = "Trash"
    })


    @if (!Model.Any())
    {
        <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-outline-variant bg-surface-container-lowest px-6 py-16 text-center">
            <svg class="mb-4 h-12 w-12 text-outline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            <h2 class="text-headline-sm text-on-surface">Çöp kutunuz boş</h2>
            <p class="mt-2 max-w-sm text-body-sm text-on-surface-variant">
                Sildiğiniz mesajlar burada bekler. Geri yükleyerek eski yerlerine döndürebilirsiniz.
            </p>
            <a asp-controller="Message" asp-action="Index"
               class="mt-6 rounded-lg border border-outline-variant px-5 py-2.5 text-label-md text-primary transition-colors hover:bg-primary/10">
                Gelen kutusuna dön
            </a>
        </div>
    }
    else
    {
        <div class="mb-stack-md rounded-lg border border-outline-variant bg-surface-container-low px-4 py-3">
            <p class="text-body-sm text-on-surface-variant">
                Bu mesajlar yalnızca sizin kutunuzdan kaldırıldı. Soldaki ok simgesiyle geri yükleyebilirsiniz.
            </p>
        </div>

        @await Component.InvokeAsync("_UserMessageList", new { messages = Model, trashMode = true })


        @await Component.InvokeAsync("_Pagination", new
         {
            filter = (PostaKutusuServisi.DTOs.UserMessageDto.MessageFilterDto)ViewBag.Filter,
            totalPages = (int)ViewBag.TotalPages,
            totalCount = (int)ViewBag.TotalCount,
            action = "Trash"
        })
    }


</div>
