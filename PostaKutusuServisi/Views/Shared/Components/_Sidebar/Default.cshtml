@model PostaKutusuServisi.Models.SidebarViewModel

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    var activeClass = "flex items-center gap-3 rounded-lg px-4 py-2.5 text-label-md bg-primary-container text-white transition-colors";
    var passiveClass = "flex items-center gap-3 rounded-lg px-4 py-2.5 text-label-md text-on-surface-variant transition-colors hover:bg-surface-container-high hover:text-on-surface";
    var currentCategoryId = ViewContext.HttpContext.Request.Query["CategoryId"].ToString();
    bool isCategoryPage = controller == "Category";


    bool isInboxActive = controller == "Message" && action == "Index";
    bool isImportantActive = controller == "Message" && action == "Important";
    bool isDraftsActive = controller == "Message" && action == "Drafts";
    bool isSentActive = controller == "Message" && action == "Sent";
    bool isTrashActive = controller == "Message" && action == "Trash";
}

<!-- mobil karartma -->
<div id="sidebarOverlay"
     class="pointer-events-none fixed inset-0 z-40 bg-black/60 opacity-0 transition-opacity duration-300 lg:hidden"></div>

<!-- kenar menü -->
<aside id="sidebar"
       class="fixed left-0 top-18 z-50 flex h-[calc(100vh-4.5rem)] w-64 -translate-x-full transform flex-col border-r border-outline-variant bg-surface-container transition-transform duration-300 ease-in-out lg:translate-x-0">

    <!-- yeni mesaj -->
    <div class="p-4 pb-2">
        <a asp-controller="Message" asp-action="SendMail"
           class="flex w-full items-center justify-center gap-2 rounded-lg bg-primary-container px-4 py-2.5 text-label-md text-white transition-all hover:opacity-90 active:scale-[0.98]">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            Yeni Mesaj
        </a>
    </div>

    <!-- menü -->
    <nav class="flex flex-1 flex-col gap-1 overflow-y-auto px-4 py-2">

        <a asp-controller="Message" asp-action="Index" class="@(isInboxActive ? activeClass : passiveClass)">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
            </svg>
            <span class="flex-1">Gelen Kutusu</span>
            @if (Model.UnreadCount > 0)
            {
                <span class="shrink-0 rounded-full @(isInboxActive ? "bg-white/20 text-white" : "bg-primary text-on-primary") px-2 py-0.5 text-label-sm">
                    @Model.UnreadCount
                </span>
            }
        </a>

        <a asp-controller="Message" asp-action="Important" class="@(isImportantActive? activeClass : passiveClass)">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
            <span>Yıldızlı</span>
        </a>

        <a asp-controller="Message" asp-action="Drafts" class="@(isDraftsActive? activeClass : passiveClass)">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <span>Taslaklar</span>
        </a>

        <a asp-controller="Message" asp-action="Sent" class="@(isSentActive? activeClass : passiveClass)">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            <span>Gönderilmiş</span>
        </a>

        <a asp-controller="Message" asp-action="Trash" class="@(isTrashActive? activeClass : passiveClass)">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            <span>Çöp Kutusu</span>
        </a>

        <!-- kategoriler -->
        <div class="mt-stack-md border-t border-outline-variant pt-stack-md">

            <div class="mb-1 flex items-center justify-between px-4">
                <span class="text-label-sm text-outline">KATEGORİLER</span>
                <a asp-controller="Category" asp-action="Index"
                   aria-label="Kategorileri yönet"
                   class="rounded p-1 text-outline transition-colors hover:bg-surface-container-high hover:text-on-surface">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </a>
            </div>

            @if (Model.Categories is not null && Model.Categories.Any())
            {
                @foreach (var category in Model.Categories)
                {
                    var isActive = currentCategoryId == category.Id.ToString();

                    <a asp-controller="Message" asp-action="Index" asp-route-CategoryId="@category.Id"
                       class="@(isActive ? activeClass : passiveClass)">
                        <span class="h-3 w-3 shrink-0 rounded-full" style="background-color: @(category.Color ?? "#3b72e0")"></span>
                        <span class="truncate">@category.Name</span>
                    </a>
                }
            }
            else
            {
                <a asp-controller="Category" asp-action="Index"
                   class="@passiveClass text-label-sm">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                    <span>Kategori oluştur</span>
                </a>
            }

        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="mt-stack-md border-t border-outline-variant pt-stack-md">

                <span class="mb-1 block px-4 text-label-sm text-outline">YÖNETİM</span>

                <a asp-controller="Admin" asp-action="Index"
                   class="@(controller == "Admin" && action == "Index" ? activeClass : passiveClass)">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
                    </svg>
                    <span>Yönetim Paneli</span>
                </a>

                <a asp-controller="Admin" asp-action="Users"
                   class="@(controller == "Admin" && action == "Users" ? activeClass : passiveClass)">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    <span>Kullanıcılar</span>
                </a>

                <a asp-controller="Admin" asp-action="Reports"
                   class="@(controller == "Admin" && action == "Reports" ? activeClass : passiveClass)">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M12 9v2m0 4h.01M5.062 21h13.876c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 18c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <span>Şikayetler</span>
                </a>

            </div>
        }



    </nav>

    <!-- alt bölüm: kullanıcı + çıkış -->
    <div class="border-t border-outline-variant p-4">


        @if (Model.CurrentUser is not null)
        {
            <a asp-controller="Profile" asp-action="Index"
               class="mb-2 flex items-center gap-3 rounded-lg px-1 py-1 transition-colors hover:bg-surface-container-high">

                @await Component.InvokeAsync("_Avatar", new { user = Model.CurrentUser, size = "sm" })

                <div class="flex min-w-0 flex-col">
                    <span class="truncate text-label-md text-on-surface">@Model.CurrentUser.FirstName @Model.CurrentUser.LastName</span>
                    <span class="truncate text-label-sm text-on-surface-variant">@Model.CurrentUser.Email</span>
                </div>
            </a>
        }



        <form asp-controller="Auth" asp-action="Logout" method="post">
            <button type="submit"
                    class="flex w-full items-center gap-3 rounded-lg px-4 py-2.5 text-label-md text-error transition-colors hover:bg-error/10">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                <span>Çıkış Yap</span>
            </button>
        </form>

    </div>

</aside>
