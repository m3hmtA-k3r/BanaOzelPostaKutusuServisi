@model PostaKutusuServisi.Models.UstBaslikViewModel

<div class="mb-stack-lg flex flex-col gap-stack-md sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h1 class="text-headline-md text-on-surface">Merhaba @Model.FullName</h1>
        <p class="mt-1 text-body-sm text-on-surface-variant">
            @if (Model.UnreadCount > 0)
            {
                <span class="text-primary">@Model.UnreadCount okunmamış mesaj</span>
            }
            else
            {
                <span>Tüm mesajlarınız okundu</span>
            }
        </p>
    </div>

    <a asp-controller="Message" asp-action="SendMail"
       class="flex items-center justify-center gap-2 rounded-lg bg-primary-container px-5 py-2.5 text-label-md text-white transition-all hover:opacity-90 active:scale-[0.98]">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Yeni Mesaj
    </a>
</div>
