@model PostaKutusuServisi.Models.UserMessageListViewModel

<div class="overflow-hidden rounded-lg border border-outline-variant">

    @foreach (var item in Model.Messages)
    {
        var isSender = item.SenderId == Model.CurrentUserId;
        var person = isSender ? item.Receiver : item.Sender;
        var highlight = !isSender && !item.IsRead;

        <div class="group flex items-center gap-3 border-b border-outline-variant px-4 py-2.5 transition-colors last:border-b-0 @(highlight ? "bg-surface-container-low hover:bg-surface-container-high" : "bg-surface-container-lowest hover:bg-surface-container-high")">

            @if (Model.TrashMode)
            {
                <!-- geri yükle -->
                <form asp-controller="Message" asp-action="Restore" method="post" class="flex shrink-0 items-center">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit" aria-label="Geri yükle"
                            class="flex items-center justify-center rounded p-1 text-outline transition-colors hover:text-primary">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
                        </svg>
                    </button>
                </form>
            }
            else
            {
                <!-- yıldız -->
                <form asp-controller="Message" asp-action="ToggleImportant" method="post" class="flex shrink-0 items-center">
                    <input type="hidden" name="id" value="@item.Id" />
                    <input type="hidden" name="returnAction" value="@ViewContext.RouteData.Values["action"]" />
                    <button type="submit"
                            aria-label="@(item.IsImportant ? "Yıldızı kaldır" : "Yıldızla")"
                            class="flex items-center justify-center rounded p-1 transition-colors @(item.IsImportant ? "text-tertiary hover:text-tertiary-fixed" : "text-outline hover:text-on-surface")">
                        <svg class="h-4 w-4" fill="@(item.IsImportant ? "currentColor" : "none")" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                        </svg>
                    </button>
                </form>
            }

            <!-- mesaj bağlantısı -->
            <a href="/Message/MailDetail/@item.Id" class="flex min-w-0 flex-1 items-center gap-3">

                <span class="w-32 shrink-0 truncate sm:w-44 @(highlight ? "text-label-md text-on-surface" : "text-body-sm text-on-surface-variant")">
                    @if (isSender)
                    {
                        <span class="text-outline">Kime: </span>
                    }
                    @person.FirstName @person.LastName
                </span>

                <span class="min-w-0 flex-1 truncate">
                    <span class="@(highlight ? "text-label-md text-on-surface" : "text-body-sm text-on-surface-variant")">
                        @item.Subject
                    </span>
                    <span class="text-body-sm text-outline">
                        &ndash; @item.Body
                    </span>
                </span>

                @if (isSender)
                {
                    <span class="hidden shrink-0 rounded-full border px-2 py-0.5 text-label-sm sm:inline-block @(item.IsRead ? "border-outline-variant text-outline" : "border-primary/40 text-primary")">
                        @(item.IsRead ? "Okundu" : "Okunmadı")
                    </span>
                }

                @if (item.Category is not null)
                {
                    <span class="hidden shrink-0 items-center gap-1.5 rounded-full border border-outline-variant px-2 py-0.5 text-label-sm text-on-surface-variant sm:inline-flex">
                        <span class="h-2 w-2 rounded-full" style="background-color: @(item.Category.Color ?? "#3b72e0")"></span>
                        @item.Category.Name
                    </span>
                }

            <span class="w-16 shrink-0 text-right text-label-sm @(highlight ? "text-on-surface" : "text-outline")">
                @(item.SendDate.Date == DateTime.Today
                                ? item.SendDate.ToString("HH:mm")
                                : item.SendDate.ToString("d MMM"))
            </span>

            </a>

        @if (!Model.TrashMode)
            {
                <form asp-controller="Message" asp-action="Delete" method="post" class="shrink-0">
                    <input type="hidden" name="id" value="@item.Id" />
                    <input type="hidden" name="returnAction" value="@ViewContext.RouteData.Values["action"]" />
                    <button type="submit" aria-label="Mesajı sil"
                            class="rounded p-1 text-outline opacity-0 transition-all hover:text-error group-hover:opacity-100">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                    </button>
                </form>
            }

        </div>
    }

</div>
