@*
   _LayoutHeader Kısmı
*@

<header class="sticky top-0 z-50 border-b border-outline-variant bg-surface/90 backdrop-blur-md">
    <nav class="mx-auto flex h-18 max-w-7xl items-center justify-between px-6 lg:px-8">

        <!-- Logo -->
        <a asp-controller="Home"
           asp-action="Index"
           class="flex items-center gap-3 text-primary transition hover:opacity-90">

            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-white shadow-md">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M3 8l8.89 5.93a2 2 0 002.22 0L23 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
            </div>

            <div>
                <div class="text-lg font-bold leading-none">Posta Kutusu</div>
                <div class="text-xs text-on-surface-variant">Yönetim Sistemi</div>
            </div>

        </a>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <!-- Mobil menü düğmesi -->
            <button id="menuButton" aria-label="Menüyü aç"
                    class="rounded-lg p-2 text-on-surface-variant transition hover:bg-surface-container-high hover:text-on-surface lg:hidden">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        }
        else
        {
            <div class="flex items-center gap-2">
                <a asp-controller="Auth" asp-action="Login"
                   class="rounded-xl px-4 py-2 text-sm font-medium text-on-surface-variant transition-all duration-200 hover:bg-primary/10 hover:text-primary">
                    Giriş Yap
                </a>
                <a asp-controller="Auth" asp-action="Register"
                   class="rounded-xl bg-primary-container px-4 py-2 text-sm font-medium text-white transition-all duration-200 hover:opacity-90">
                    Kayıt Ol
                </a>
            </div>
        }

    </nav>
</header>
