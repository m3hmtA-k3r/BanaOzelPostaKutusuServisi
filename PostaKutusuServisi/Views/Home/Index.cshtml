@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="relative overflow-hidden">

    <!-- arka plan ışığı -->
    <div class="pointer-events-none absolute inset-0 z-0 flex items-start justify-center opacity-30">
        <div class="h-[600px] w-[600px] rounded-full bg-primary-fixed opacity-20 blur-3xl"></div>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-3xl py-12 text-center">

        <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-xl bg-primary text-white shadow-md">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3 8l8.89 5.93a2 2 0 002.22 0L23 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
        </div>

        <h1 class="text-headline-lg text-on-surface">Kapalı devre posta kutusu</h1>

        <p class="mx-auto mt-4 max-w-xl text-body-lg text-on-surface-variant">
            PostaKutusuServisi, yalnızca sisteme kayıtlı kullanıcıların birbirine
            yazabildiği bir iç yazışma ortamıdır. Mesajlarınız dış e-posta
            servislerine gitmez, sistemin dışına çıkmaz.
        </p>

        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <a asp-controller="Auth" asp-action="Register"
               class="rounded-lg bg-primary-container px-6 py-3 text-label-md text-white transition-all hover:opacity-90 active:scale-[0.98]">
                Hesap Oluştur
            </a>
            <a asp-controller="Auth" asp-action="Login"
               class="rounded-lg border border-outline-variant px-6 py-3 text-label-md text-on-surface transition-colors hover:bg-surface-container-high">
                Giriş Yap
            </a>
        </div>

    </div>

    <!-- özellikler -->
    <div class="relative z-10 mx-auto grid w-full max-w-5xl gap-stack-md pb-12 sm:grid-cols-3">
